#include <winres.h>
#include "resource.h"
#include "version.h"

IDD_CONFIG DIALOGEX 0, 0, 280, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HLS input settings"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "Network timeout (ms):", -1, 8, 10, 100, 10
    EDITTEXT IDC_TIMEOUT, 116, 8, 60, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Buffer (ms):", -1, 8, 28, 100, 10
    EDITTEXT IDC_BUFFER, 116, 26, 60, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "User agent:", -1, 8, 46, 100, 10
    EDITTEXT IDC_UA, 116, 44, 154, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Write a diagnostic log beside the plug-in", IDC_LOG, 8, 66, 200, 12
    AUTOCHECKBOX "Reconnect if the connection drops", IDC_RECONNECT, 8, 82, 200, 12
    DEFPUSHBUTTON "OK", IDOK, 168, 108, 48, 14
    PUSHBUTTON "Cancel", IDCANCEL, 222, 108, 48, 14
END

IDD_INFOBOX DIALOGEX 0, 0, 320, 248
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HLS stream info"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "URL:", -1, 8, 10, 28, 10
    EDITTEXT IDC_INFO_URL, 40, 8, 272, 28, ES_AUTOHSCROLL | ES_MULTILINE | ES_READONLY | WS_VSCROLL
    LTEXT "Title:", -1, 8, 44, 28, 10
    EDITTEXT IDC_INFO_TITLE, 40, 42, 272, 14, ES_AUTOHSCROLL | ES_READONLY
    LTEXT "Type:", -1, 8, 64, 28, 10
    EDITTEXT IDC_INFO_TYPE, 40, 62, 272, 14, ES_AUTOHSCROLL | ES_READONLY
    LTEXT "Audio:", -1, 8, 84, 28, 10
    EDITTEXT IDC_INFO_AUDIO, 40, 82, 272, 14, ES_AUTOHSCROLL | ES_READONLY
    GROUPBOX "Live status", -1, 8, 102, 304, 118
    EDITTEXT IDC_INFO_STATUS, 14, 116, 292, 96, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "OK", IDOK, 264, 226, 48, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "in_hls contributors"
            VALUE "FileDescription", "Winamp HLS input plug-in"
            VALUE "FileVersion", IN_HLS_VERSION
            VALUE "InternalName", "in_hls.dll"
            VALUE "LegalCopyright", "See LICENSE.md. FFmpeg is covered separately."
            VALUE "OriginalFilename", "in_hls.dll"
            VALUE "ProductName", "in_hls"
            VALUE "ProductVersion", IN_HLS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
